# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=1)
DATABASE_URL=

# Directory holding one credential file per connection. See docs/credentials.md.
# @type=string(minLength=1)
CREDENTIALS_DIR=

# Signs the session cookie. GitHub sign-in also needs GITHUB_CLIENT_ID and
# GITHUB_CLIENT_SECRET, which only matter once that provider is turned on.
# @type=string(minLength=1)
BETTER_AUTH_SECRET=
