# @defaultRequired=true
# @defaultSensitive=true
# Every value is read when the server starts. None is baked into the build.
# @defaultDynamic
# Paths and local addresses are not secrets and do turn up in answers, so a
# response that mentions one is not treated as a leak.
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=1)
# @sensitive={preventLeaks=false}
DATABASE_URL=

# Directory holding one credential file per connection. See docs/credentials.md.
# @type=string(minLength=1)
# @sensitive={preventLeaks=false}
CREDENTIALS_DIR=

# The GitHub token used for pull request review, stored on its own.
# @type=string(minLength=1)
# @sensitive={preventLeaks=false}
GITHUB_TOKEN_FILE=

# Local cache of https://models.dev/api.json for the provider settings.
# @type=string(minLength=1)
# @sensitive={preventLeaks=false}
MODELS_DEV_CACHE_FILE=

# The model proxy: CLIProxyAPI, which this server starts through cpajs. It
# listens on PROXY_URL's port, bound to PROXY_HOST, and accepts PROXY_API_KEY.
# Only servers talk to it: this one and the worker.
# @type=url
# @sensitive={preventLeaks=false}
PROXY_URL=http://127.0.0.1:8317
# @type=string(minLength=1)
PROXY_API_KEY=
# @required=false
# @sensitive={preventLeaks=false}
PROXY_HOST=127.0.0.1
# Its state: the generated config and the ChatGPT sign-in auth files.
# @type=string(minLength=1)
# @sensitive={preventLeaks=false}
PROXY_DATA_DIR=

# Redis behind the BullMQ queue that titles threads.
# @type=url
REDIS_URL=redis://127.0.0.1:6379

# The MCP server behind the web search and fetch tools: sex-lite
# (https://github.com/AkaraChen/sex), e.g. http://127.0.0.1:3002/mcp. Without
# it, the model cannot search or read the web.
# @required=false @type=url
# @sensitive={preventLeaks=false}
WEB_MCP_URL=

# Signs the session cookie.
# @type=string(minLength=1)
BETTER_AUTH_SECRET=

# GitHub sign-in, from the instance's GitHub App. See docs/deploy.md. The
# client ID is public: it is part of the sign-in URL the browser is sent to.
# @public @type=string(minLength=1)
GITHUB_CLIENT_ID=
# @type=string(minLength=1)
GITHUB_CLIENT_SECRET=
