# @defaultRequired=true
# @defaultSensitive=true
# Every value is read when the server starts. None is baked into the build.
# @defaultDynamic
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=1)
DATABASE_URL=

# Directory holding one credential file per connection. See docs/credentials.md.
# @type=string(minLength=1)
CREDENTIALS_DIR=

# The GitHub token used for pull request review, stored on its own.
# @type=string(minLength=1)
GITHUB_TOKEN_FILE=

# Local cache of https://models.dev/api.json for the provider settings.
# @type=string(minLength=1)
MODELS_DEV_CACHE_FILE=

# The model proxy (apps/proxy, CLIProxyAPI through cpajs) and the key it accepts. Only the server
# talks to it.
# @type=url
PROXY_URL=http://127.0.0.1:8317
# @type=string(minLength=1)
PROXY_API_KEY=

# Redis behind the BullMQ queue that titles threads.
# @type=url
REDIS_URL=redis://127.0.0.1:6379

# Signs the session cookie.
# @type=string(minLength=1)
BETTER_AUTH_SECRET=

# GitHub sign-in, from the instance's GitHub App. See docs/deploy.md. The
# client ID is public: it is part of the sign-in URL the browser is sent to.
# @public @type=string(minLength=1)
GITHUB_CLIENT_ID=
# @type=string(minLength=1)
GITHUB_CLIENT_SECRET=
